# SMTP connection used to send change alert emails
#
# Gmail example: to send via Gmail's SMTP relay you need an "App Password",
# not your normal account password (App Passwords require 2-Step
# Verification to be enabled on the Google account):
# https://support.google.com/accounts/answer/185833
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=your-16-character-app-password
#
# (Port 587 with SMTP_SECURE=false also works, using STARTTLS instead of
# implicit TLS.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Envelope addresses for alert emails
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=you@example.com

# MongoDB connection used to store fetch results (for change detection) and
# the watch list managed via the CRUD API
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=watcher

# Port the watch management (CRUD) API listens on
PORT=3000

# Optional: path to a config file used to seed the initial watch list into
# MongoDB the first time the app runs against an empty "watches" collection
# (defaults to config/config.json)
CONFIG_PATH=config/config.json
