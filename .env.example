# SMTP connection used to send change alert emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Envelope addresses for alert emails
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=you@example.com

# Optional: path to the watch config file (defaults to config/config.json)
CONFIG_PATH=config/config.json

# Optional: path to the state file used to detect changes (defaults to data/state.json)
STATE_PATH=data/state.json
